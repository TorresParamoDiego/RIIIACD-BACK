# Copia como .env y ajusta. Nunca subas .env al repositorio.

ENTORNO=desarrollo
DATABASE_URL=postgresql+psycopg://riiiacd:cambia-esta-clave@localhost:5432/riiiacd
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion

# Sitio público (para construir los enlaces /actualizar/{token}) y URL pública de esta API.
PUBLIC_SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]
# Panel administrativo (aplicación separada). PENDIENTE (brief 4.4): repositorio riiiacd-admin.
ADMIN_ORIGINS=["http://localhost:5174"]

# En desarrollo local sin HTTPS, las cookies Secure no se envían: ponlo en false SOLO en local.
SESSION_COOKIE_SECURE=true

# Fotografías. PENDIENTE (brief 4.9): confirmar 2 MB.
PHOTO_MAX_BYTES=2097152
STORAGE_BACKEND=local
MEDIA_ROOT=media
# Para STORAGE_BACKEND=s3 (requiere pip install .[s3]):
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# SMTP institucional. PENDIENTE (brief 4.2). Sin SMTP_HOST, los enlaces se comparten a mano.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=riiiacd@celaya.tecnm.mx
# SMTP_STARTTLS=true

# Texto de autorización del correo público. PENDIENTE (brief 4.8).
# Si cambias el texto, cambia también la versión.
CONSENT_TEXT_VERSION=borrador-0

# Solo detrás de un proxy inverso de confianza (Nginx, etc.).
TRUST_PROXY_HEADERS=false
